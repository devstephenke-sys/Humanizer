# Copy to .env in the repository root. Never commit the real file.

# development | production
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local default. For Neon, use the pooled connection string.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./draftwell.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# openai | anthropic | ollama
AI_PROVIDER=openai

# OpenAI, or any OpenAI-compatible endpoint (OpenRouter, Groq, Together, a local gateway).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Used when AI_PROVIDER=ollama. Ollama must be running locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Same ceiling for every user. This is abuse protection, not a paid quota.
MAX_INPUT_CHARS=60000
RATE_LIMIT_WRITES=40
RATE_LIMIT_WINDOW_SECONDS=600

# Frontend production build. Leave empty in local dev so Vite can proxy /api.
VITE_API_URL=
